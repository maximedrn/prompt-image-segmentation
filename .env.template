# Authentication.
AUTH_MODE="basic"
SEGMENTATION_USERNAME=
SEGMENTATION_PASSWORD=

# Runtime.
HOST="0.0.0.0"
PORT=7860
DEFAULT_SEGMENTER="sam_dino"

# Gradio UI.
ENABLE_UI=false
UI_MOUNT_PATH="/"

# Job queue.
JOB_BACKEND="redis"
REDIS_URL="redis://redis:6379/0"
JOB_RETENTION_SECONDS=3600
JOB_MAX_QUEUE_DEPTH=100

# Webhooks.
WEBHOOK_SIGNING_SECRET=
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_INITIAL_BACKOFF_SECONDS=1
WEBHOOK_ALLOW_INSECURE=false

# Request limits.
MAX_UPLOAD_BYTES=20971520
MAX_IMAGE_PIXELS=40000000
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
MAX_TRACKED_CLIENTS=10000

# Face analysis.
FACE_SCORE_THRESHOLD=0.8

# Detection tuning.
DETECTION_SCORE_THRESHOLD=0.3
TEXT_SCORE_THRESHOLD=0.25
RELIABILITY_THRESHOLD=0.4
MINIMUM_CONFIDENCE=0
MASK_PADDING_PERCENTAGE=10
DILATION_PERCENTAGE=0
