# Authentication. `basic` refuses to start without credentials; set
# `none` to serve openly, and mean it.
AUTH_MODE="basic"
SEGMENTATION_USERNAME=
SEGMENTATION_PASSWORD=

# Runtime. HOST=0.0.0.0 listens on every interface: keep the container
# behind a proxy, or publish the port only where you intend to.
HOST="0.0.0.0"
PORT=7860
DEFAULT_SEGMENTER="sam_dino"

# Gradio UI. Off by default: production serves the JSON API only and
# never imports gradio.
ENABLE_UI=false
UI_MOUNT_PATH="/"

# Request limits. Uvicorn enforces no body limit of its own, so these
# are the only guard between a client and the heap.
MAX_UPLOAD_BYTES=20971520
MAX_IMAGE_PIXELS=40000000
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
MAX_TRACKED_CLIENTS=10000

# Face analysis. YuNet answers on animal faces too; on the bundled
# examples a human scores 0.94 while a dog and a cat score 0.71 and
# 0.67. Re-measure on real traffic before moving this.
FACE_SCORE_THRESHOLD=0.8

# Detection tuning.
DETECTION_SCORE_THRESHOLD=0.3
TEXT_SCORE_THRESHOLD=0.25
RELIABILITY_THRESHOLD=0.4
MASK_PADDING_PCT=10
DILATION_PCT=3.0
