  // ``poe spell`` walks the whole tree, so this list is the only place
  // deciding what goes unchecked. Dot-entries (``.venv``, ``.github``,
  // ``.env``) and binaries (the PNGs under ``examples``) are already out
  // via cspell's own defaults; the caches are repeated here so no
  // explicit path can drag them back in.
  "ignorePaths": [
    "**/.venv/**",
    "**/.mypy_cache/**",
    "**/.pytest_cache/**",
    "**/.ruff_cache/**",
    "**/__pycache__/**",
    "**/*.pyc",
    "**/*.pyo",
    "pyproject.toml",
    "poetry.lock",
    "cspell.json",
    "lefthook.yaml",
    "LICENSE",
    "Dockerfile",
    ".github/workflows/**.yaml"
  ]
}
